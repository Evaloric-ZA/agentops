# dependencies
node_modules/

# the frontend bundle
dist/

# the Rust build tree
src-tauri/target/
src-tauri/gen/

# the mobile icon sets. This is a desktop application, and every icon is
# regenerated from icons/source.png, which is the committed source of truth.
src-tauri/icons/android/
src-tauri/icons/ios/

# the macOS bundle, if it is ever produced outside target/
*.dmg
*.app

# Python bytecode. The scanner and its test are plain scripts, but
# importing one of them writes a cache directory next to it.
__pycache__/
*.pyc

# local environment and editor state
.env
.env.*
!.env.example
*.local
.DS_Store
.idea/
.vscode/
